{
    "name": "mdmridul6/laravel-monitor",
    "description": "A Laravel package for monitoring application health and deployment metadata",
    "keywords": ["laravel", "monitoring", "health-check", "telemetry"],
    "license": "MIT",
    "authors": [
        {
            "name": "Mridul",
            "email": "mdmridul6@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/queue": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "pestphp/pest": "^2.0",
        "mockery/mockery": "^1.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Vendor\\LaravelMonitor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vendor\\LaravelMonitor\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vendor\\LaravelMonitor\\LaravelMonitorServiceProvider"
            ]
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "config": {
        "preferred-install": {
            "pestphp/pest-plugin": "dist"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [{
        "name": "monitor",
        "type": "path",
        "url": "."
    }]
}
